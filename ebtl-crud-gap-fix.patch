 .success{background:#e8f6ef;color:#165b3b;border:1px solid #b7e1cc;padding:12px;border-radius:12px}.formGrid{grid-template-columns:repeat(3,minmax(0,1fr));align-items:end}.formGrid .full{grid-column:1/-1}.formGrid label{margin:0}.formGrid input[type="checkbox"]{width:auto;margin-right:8px}.checks{display:flex;flex-wrap:wrap;gap:10px;margin-top:8px}.checks label{border:1px solid var(--line);border-radius:999px;padding:8px 12px;background:#fff}.inlineRow{display:grid;grid-template-columns:2fr 1fr 120px;gap:10px;margin:10px 0}.inlineActions{display:flex;gap:8px;flex-wrap:wrap}@media(max-width:980px){.formGrid{grid-template-columns:1fr}.inlineRow{grid-template-columns:1fr}}
+
+.helperText{padding:10px 12px;margin-bottom:12px;border:1px solid var(--line);border-radius:12px;background:#fff}
+.requiredHint{font-weight:600;color:var(--danger);font-size:12px;margin-left:6px}
+input[aria-invalid="true"]{border-color:var(--danger)}
+button:disabled,input:disabled,select:disabled{opacity:.65;cursor:not-allowed;background:#f3eee7}
