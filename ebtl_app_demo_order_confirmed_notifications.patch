+import 'package:flutter/foundation.dart';
+import 'package:flutter/services.dart';
+
+import 'api_service.dart';
+
+class PushNotificationService {
+  static const MethodChannel _channel = MethodChannel('ebtl/push_notifications');
+
+  static Future<void> registerDeviceIfAvailable() async {
+    try {
+      final token = await _channel.invokeMethod<String>('getToken');
+      final cleanToken = token?.trim();
+      if (cleanToken == null || cleanToken.isEmpty) return;
+
+      await ApiService.registerCustomerPushToken(
+        token: cleanToken,
+        platform: defaultTargetPlatform.name,
+      );
+    } on MissingPluginException {
+      // Native push notification registration has not been wired yet.
+    } catch (_) {
+      // Push registration should never block checkout or app startup.
+    }
+  }
+}
