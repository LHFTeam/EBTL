PORT=10000
NODE_ENV=development
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
SESSION_SECRET=replace-with-a-long-random-string
# Payment mode controls checkout behavior. Use live to charge through the gateway,
# demo to confirm orders immediately without opening a payment sheet.
PAYMENT_MODE=live

# Which live gateway backs checkout: stripe (default) or geidea.
PAYMENT_PROVIDER=stripe

# Abandoned checkouts leave an order stuck at pending_payment. The server sweeps
# them on this interval and marks them `expired` once they are older than the
# max age, cancelling the Stripe payment intent so they cannot be paid after the
# fact. This is the customer's payment window, not a webhook grace period —
# webhooks land in seconds. Defaults shown.
PENDING_ORDER_MAX_AGE_MINUTES=30
PENDING_ORDER_SWEEP_INTERVAL_MINUTES=10

# Rate limiting for the public customer API (per IP). Reads are never limited;
# these cap session creation and write endpoints. Defaults shown; raise them if
# many customers share one NAT'd IP.
RATE_LIMIT_SESSION_MAX=60
RATE_LIMIT_SESSION_WINDOW_MIN=15
RATE_LIMIT_WRITE_MAX=300
RATE_LIMIT_WRITE_WINDOW_MIN=15

# Public landing-page web container. GTM owns the GA4, Meta Pixel, Microsoft
# Clarity, and future Snapchat tags. It is loaded only in production and never
# by the employee/admin SPA.
GTM_CONTAINER_ID=GTM-WN6DZGBS

# Push notifications. Set PUSH_PROVIDER=fcm for Firebase Cloud Messaging HTTP v1 or expo for Expo push tokens.
PUSH_NOTIFICATIONS_ENABLED=false
PUSH_PROVIDER=none
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_CLIENT_EMAIL=
FCM_SERVICE_ACCOUNT_PRIVATE_KEY=
EXPO_ACCESS_TOKEN=

ADMIN_USERS=[{"username":"admin","password":"change-me-now","role":"admin","name":"EBTL Admin"},{"username":"warehouse","password":"change-me-now","role":"warehouse","name":"Warehouse"},{"username":"cart","password":"change-me-now","role":"cart_operator","name":"Cart Operator"}]

# Geidea payment integration
GEIDEA_IS_SANDBOX=true
GEIDEA_REGION=egy
GEIDEA_LANGUAGE=en

GEIDEA_MERCHANT_PUBLIC_KEY=replace-after-geidea-onboarding
GEIDEA_API_PASSWORD=replace-after-geidea-onboarding

# Use either GEIDEA_CREATE_SESSION_URL directly, or set GEIDEA_BASE_URL and let the backend append /payment-intent/api/v2/direct/session
GEIDEA_BASE_URL=https://api.merchant.geidea.net
GEIDEA_CREATE_SESSION_URL=
GEIDEA_CALLBACK_URL=https://YOUR_PUBLIC_BACKEND_URL/api/payments/geidea/callback
GEIDEA_RETURN_URL=ebtl://payment-return
GEIDEA_APPLE_PAY_MERCHANT_ID=merchant.com.yourcompany.ebtl

# Stripe payment integration (used when PAYMENT_PROVIDER=stripe).
# Keys come from the Stripe Dashboard (test keys start with sk_test_ / pk_test_).
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_PUBLISHABLE_KEY=pk_test_replace_me
# Create a webhook endpoint in the Stripe Dashboard pointing at
# https://YOUR_PUBLIC_BACKEND_URL/api/payments/stripe/webhook and paste its
# signing secret here. Subscribe it to payment_intent.succeeded and
# payment_intent.payment_failed.
STRIPE_WEBHOOK_SECRET=whsec_replace_me
# Must match the Stripe API version the flutter_stripe SDK speaks; used only for
# the ephemeral key that lets the Payment Sheet manage saved cards.
STRIPE_API_VERSION=2024-06-20
# Shown as the merchant name in the Payment Sheet / Apple Pay / Google Pay.
STRIPE_MERCHANT_DISPLAY_NAME=EBTL
# ISO country of the Stripe account (US for the EBTL US entity).
STRIPE_MERCHANT_COUNTRY=US
# Apple Pay merchant id (leave blank until Apple Pay is set up). Google Pay is a
# simple on/off once the Android app is configured.
STRIPE_APPLE_PAY_MERCHANT_ID=
STRIPE_GOOGLE_PAY_ENABLED=false
