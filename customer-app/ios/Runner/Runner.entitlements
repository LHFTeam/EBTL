<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Debug and Profile only. The Release configuration signs against
	     RunnerRelease.entitlements, which asks for the production APNs
	     environment that TestFlight and App Store builds need. -->
	<key>aps-environment</key>
	<string>development</string>
	<!-- Sign in with Apple. Required by App Store guideline 4.8 because the app
	     also offers Facebook and Google sign-in; without the entitlement the
	     authorisation sheet fails at runtime with error 1000. Must stay in step
	     with RunnerRelease.entitlements. -->
	<key>com.apple.developer.applesignin</key>
	<array>
		<string>Default</string>
	</array>
</dict>
</plist>
